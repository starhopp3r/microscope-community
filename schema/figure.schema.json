{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Microscope community figure",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "author", "prompt", "kind", "agent", "skill", "build", "pages", "license", "created"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "author": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$" },
    "prompt": { "type": "string", "minLength": 1, "maxLength": 600 },
    "kind": { "enum": ["SVG", "SVG + WebGL", "SVG + 3D", "SVG + WebGL + 3D"] },
    "agent": { "enum": ["Claude Code", "OpenCode", "Codex", "Antigravity", "Other"] },
    "model": { "type": "string", "minLength": 1, "maxLength": 60 },
    "minutes": { "type": "integer", "minimum": 1, "maximum": 6000 },
    "tokens": { "type": "integer", "minimum": 1, "maximum": 10000000000 },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit"],
      "properties": {
        "kit": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "build": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "prefixItems": [{ "type": "string", "pattern": "^src/.+\\.m?js$" }],
        "items": { "type": "string", "pattern": "^--[a-z][a-z-]*$" }
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light"],
      "properties": {
        "dark": { "type": "string", "pattern": "^src/.+\\.html$" },
        "light": { "type": "string", "pattern": "^src/.+\\.html$" }
      }
    },
    "audit": { "type": "boolean" },
    "license": { "enum": ["MIT", "CC-BY-4.0"] },
    "tags": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 } },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "featured": { "type": "boolean" }
  }
}
